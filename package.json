{
  "name": "dsh-remote-pulse",
  "version": "0.1.0",
  "description": "Pulse — put DeepSeek Harness in your pocket with signal, not noise: semantically distilled agent activity, a decisions queue you can answer from the phone, and a task-completion push loop for when you are away.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./distill": "./lib/distill.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test --test-isolation=none \"test/*.test.js\"",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote",
    "mobile",
    "pwa",
    "notifications",
    "approval"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ssh2": "^1.17.0"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  }
}
